# Copy shared values into each V3 EasyPanel App Service.
# Use the per-app DATABASE_URL from apps/*/.env.example.

DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@postgres-app:5432/CHANGE_ME
AUTH_SECRET=CHANGE_ME_BASE64_32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=CHANGE_ME_BASE64_32
MONITORING_TOKEN=CHANGE_ME_BASE64_32
SERVICE_TO_SERVICE_TOKEN=CHANGE_ME_BASE64_32
AUTH_COOKIE_DOMAIN=.vase.ar
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
REDIS_URL=redis://redis-platform:6379
SESSION_ISSUER=app.vase.ar
SESSION_AUDIENCE=vase-platform
MIGRATION_VERSION=bootstrap
APP_VERSION=0.1.0

# Service identity
NEXT_PUBLIC_APP_URL=https://app.vase.ar
TRUSTED_ORIGINS=https://vase.ar,https://app.vase.ar,https://admin.vase.ar,https://help.vase.ar,https://business.vase.ar,https://management.vase.ar,https://labs.vase.ar,https://workplace.vase.ar
NEXT_DEPLOYMENT_ID=vase-v3-prod-001
CURRENT_V3_SERVICE=vase-app
INTERNAL_API_ALLOWLIST=vase-admin

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SECURE=false
AUTH_FROM_EMAIL=noreply@vase.ar

# Contact form
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# AI and internal APIs
AI_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_SUMMARY_MODEL=
VASE_API_KEY=

# Uploads and scanning
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_SCAN_MODE=report_only
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
STORAGE_BUCKET=vase-private
UPLOADS_BASE_URL=https://uploads.vase.ar
UPLOADS_JWT_SECRET=CHANGE_ME_SHARED_UPLOADS_SECRET

# Override per service:
# vase-portal: NEXT_PUBLIC_APP_URL=https://vase.ar CURRENT_V3_SERVICE=vase-portal DATABASE_URL=postgresql://vase_portal:CHANGE_ME@postgres-portal:5432/vase_portal
# vase-app: NEXT_PUBLIC_APP_URL=https://app.vase.ar CURRENT_V3_SERVICE=vase-app DATABASE_URL=postgresql://vase_app:CHANGE_ME@postgres-app:5432/vase_app
# vase-admin: NEXT_PUBLIC_APP_URL=https://admin.vase.ar CURRENT_V3_SERVICE=vase-admin DATABASE_URL=postgresql://vase_admin:CHANGE_ME@postgres-admin:5432/vase_admin
# vase-help: NEXT_PUBLIC_APP_URL=https://help.vase.ar CURRENT_V3_SERVICE=vase-help DATABASE_URL=postgresql://vase_help:CHANGE_ME@postgres-help:5432/vase_help
# vase-business: NEXT_PUBLIC_APP_URL=https://business.vase.ar CURRENT_V3_SERVICE=vase-business DATABASE_URL=postgresql://vase_business:CHANGE_ME@postgres-business:5432/vase_business
# vase-management: NEXT_PUBLIC_APP_URL=https://management.vase.ar CURRENT_V3_SERVICE=vase-management DATABASE_URL=postgresql://vase_management:CHANGE_ME@postgres-management:5432/vase_management
# vase-labs: NEXT_PUBLIC_APP_URL=https://labs.vase.ar CURRENT_V3_SERVICE=vase-labs DATABASE_URL=postgresql://vase_labs:CHANGE_ME@postgres-labs:5432/vase_labs
# vase-workplace: NEXT_PUBLIC_APP_URL=https://workplace.vase.ar CURRENT_V3_SERVICE=vase-workplace DATABASE_URL=postgresql://vase_workplace:CHANGE_ME@postgres-workplace:5432/vase_workplace
