# Copy these values into EasyPanel -> Service -> Environment.
# Shared secrets should stay identical across `vase` and `vase-labs`
# unless the comment says otherwise.

DATABASE_URL=mysql://vase_user:CHANGE_ME@mysql:3306/vase
AUTH_SECRET=CHANGE_ME_BASE64_32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=CHANGE_ME_BASE64_32
MONITORING_TOKEN=CHANGE_ME_BASE64_32
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Primary service identity (`vase`)
NEXT_PUBLIC_APP_URL=https://vase.ar
TRUSTED_ORIGINS=https://vase.ar,https://labs.vase.ar
NEXT_DEPLOYMENT_ID=vase-prod-001

# Bootstrap helpers
# Recommended only on the primary service.
MASTER_ADMIN_EMAIL=vasescompany912@gmail.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
TEST_ACCOUNT_EMAIL=prueba.piquim@vase.local
TEST_ACCOUNT_PASSWORD=CHANGE_ME_TEST_PASSWORD
TEST_TENANT_SLUG=piquim-prueba
TEST_TENANT_NAME=PIQUIM Prueba

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_SECURE=false
AUTH_FROM_EMAIL=noreply@vase.ar

# Contact form
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# AI and internal APIs
AI_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_SUMMARY_MODEL=
VASE_API_KEY=

# Uploads and scanning
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_SCAN_MODE=report_only
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
STORAGE_BUCKET=vase-private
UPLOADS_BASE_URL=https://uploads.vase.ar
UPLOADS_JWT_SECRET=CHANGE_ME_SHARED_UPLOADS_SECRET

# Secondary service override (`vase-labs`)
# Keep the shared secrets above and override only these values:
# NEXT_PUBLIC_APP_URL=https://labs.vase.ar
# TRUSTED_ORIGINS=https://labs.vase.ar,https://vase.ar
# NEXT_DEPLOYMENT_ID=vase-labs-prod-001
# Optional: omit MASTER_ADMIN_* and TEST_ACCOUNT_* on the secondary service.
