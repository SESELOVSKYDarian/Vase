# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
**/.next/
/out/

# production
/build
dist/
**/dist/
tmp/
**/tmp/
uploads/
**/uploads/

# misc
.DS_Store
*.pem

# local agent/editor/runtime state
.agents/
.claude/
.data/
.kiro/
.playwright-mcp/
.codex-env-values.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-next-*.log
.next-dev*.log

# local sessions / sensitive runtime artifacts
_IGNORE_session/
open-wa-session*.json
*.sw_col.json

# env files (can opt-in for committing if needed)
.env*
!.env.easypanel.example
!apps/*/.env.example
!apps/vase-editor/server/.env.example
!apps/vase-editor/web/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

