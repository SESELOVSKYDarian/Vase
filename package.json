{
  "name": "vase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/tests/*.test.ts",
    "test:integration": "vitest run src/tests/integration/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "seed:admin-master-defaults": "tsx scripts/seed-admin-master-defaults.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:reset:dev": "prisma db push --force-reset && npm run prisma:seed",
    "bootstrap:master-admin": "tsx scripts/bootstrap-master-admin.ts",
    "bootstrap:test-account": "tsx scripts/bootstrap-test-account.ts",
    "accounts:reset-default": "tsx scripts/reset-accounts-to-default.ts",
    "seed:app-roles": "tsx scripts/seed-app-roles.ts",
    "backfill:v2:bridges": "tsx scripts/backfill-v2-bridges.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@formatjs/intl-localematcher": "^0.8.2",
    "@prisma/client": "^6.6.0",
    "@types/gsap": "^1.20.2",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "jimp": "^1.6.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "negotiator": "^1.0.0",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.7",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "sanitize-html": "^2.17.2",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^28.1.0",
    "prisma": "^6.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
