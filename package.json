{
  "name": "vase",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:v3:portal": "npm run dev --workspace @vase/portal",
    "dev:v3:app": "npm run dev --workspace @vase/app",
    "dev:v3:admin": "npm run dev --workspace @vase/admin",
    "dev:v3:help": "npm run dev --workspace @vase/help",
    "dev:v3:business": "npm run dev --workspace @vase/business",
    "dev:v3:management": "npm run dev --workspace @vase/management",
    "dev:v3:labs": "npm run dev --workspace @vase/labs",
    "dev:v3:rest": "npm run dev --workspace @vase/rest",
    "dev:v3:workplace": "npm run dev --workspace @vase/workplace",
    "lint": "eslint apps packages tests",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:v3": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@formatjs/intl-localematcher": "^0.8.2",
    "@prisma/client": "^6.6.0",
    "@types/gsap": "^1.20.2",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "jimp": "^1.6.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "negotiator": "^1.0.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^8.0.11",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^28.1.0",
    "prisma": "^6.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
