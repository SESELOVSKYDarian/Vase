# Optional overrides. The signed MSI defaults to C:\ProgramData\Vase\Rest Edge.
EDGE_DATA_DIR=C:\ProgramData\Vase\Rest Edge
EDGE_HOST=0.0.0.0
EDGE_PORT=3443
EDGE_CLOUD_BASE_URL=https://rest.vase.ar

# The MSI generates the branch TLS key/certificate on first install.
# Override only when certificates are provisioned by the operator.
# EDGE_TLS_KEY_PATH=C:\ProgramData\Vase\Rest Edge\server.key
# EDGE_TLS_CERT_PATH=C:\ProgramData\Vase\Rest Edge\server.crt

# Signed automatic update channel.
EDGE_UPDATE_MANIFEST_URL=https://updates.vase.ar/rest-edge/stable.json
EDGE_UPDATE_CHANNEL=stable
# EDGE_UPDATE_PUBLIC_KEY_PATH=C:\Program Files\Vase Rest Edge\cloud-signing.pub
