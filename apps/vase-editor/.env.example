# Runtime
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://postgres:CHANGE_ME_PASSWORD@vase_vase-business-pg:5432/vase?sslmode=disable
DISABLE_AUTH=false
JWT_SECRET=CHANGE_ME_JWT_SECRET
BOOTSTRAP_TOKEN=CHANGE_ME_BOOTSTRAP_TOKEN

# Public editor URLs
PUBLIC_API_URL=https://business.vase.ar
INTEGRATIONS_PUBLIC_BASE_URL=https://business.vase.ar
PUBLIC_ADMIN_URL=https://business.vase.ar/admin/evolution
CORS_ORIGIN=https://business.vase.ar,https://vase.ar,https://piquim.vase.ar,https://teflon.vase.ar,https://piquim.ar,https://www.piquim.ar

# Vase SSO bridge
VASE_BUSINESS_SSO_SECRET=CHANGE_ME_SSO_SECRET
VASE_BUSINESS_SSO_ISSUER=vase-app
VASE_BUSINESS_SSO_AUDIENCE=vase-business
VASE_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
SERVICE_TO_SERVICE_TOKEN=CHANGE_ME_BASE64_32

# Vite build arguments
VITE_API_URL=https://business.vase.ar
VITE_EDITOR_HOST=business.vase.ar
VITE_EXTERNAL_AUTH=true
VITE_VASE_APP_URL=https://app.vase.ar
VITE_VASE_APP_LAUNCH_URL=https://app.vase.ar/app/business/launch
VITE_VASE_APP_LOGIN_URL=https://app.vase.ar/signin
VITE_VASE_APP_SIGNUP_URL=https://app.vase.ar/register

# Custom domains
PLATFORM_BASE_DOMAIN=vase.ar
PLATFORM_CNAME_TARGET=business.vase.ar
PLATFORM_APEX_IP=CHANGE_ME_SERVER_IP
AUTO_PROVISION_CUSTOM_DOMAINS=true
CLOUDFLARE_API_TOKEN=CHANGE_ME_CLOUDFLARE_TOKEN

# Uploads
UPLOADS_BASE_URL=https://uploads.vase.ar
UPLOADS_PUBLIC_BASE_URL=https://uploads.vase.ar
UPLOADS_JWT_SECRET=CHANGE_ME_UPLOADS_JWT_SECRET

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=Vase <noreply@vase.ar>
EMAIL_COMPANY_NAME=Vase
