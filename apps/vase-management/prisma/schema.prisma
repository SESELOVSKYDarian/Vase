// =============================================
// FACTURACIÓN FISCAL — ARCA/AFIP (arquitectura real, desacoplada del mock)
// =============================================

model FiscalCertificate {
  id          String    @id @default(cuid())
  companyId   String
  cuit        String
  environment String // sandbox | production
  certPath    String? // referencia a almacenamiento del certificado (no el cert en sí)
  keyAlias    String? // referencia a la clave (nunca guardar la clave privada en texto plano en DB)
  validFrom   DateTime?
  validUntil  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("fiscal_certificates")
}

model AfipRequestLog {
  id          String   @id @default(cuid())
  companyId   String
  invoiceId   String?
  service     String // WSAA | WSFEv1 | WSMTXCA | WSFEX
  environment String // sandbox | production
  requestXml  String?  @db.Text
  responseXml String?  @db.Text
  success     Boolean
  durationMs  Int?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("afip_request_logs")
}

model AfipErrorLog {
  id        String   @id @default(cuid())
  companyId String
  invoiceId String?
  service   String
  errorCode String?
  errorMsg  String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("afip_error_logs")
}

// =============================================
// LEDGER — Cuenta corriente formal (clientes y proveedores)
// Fuente de verdad: todo saldo debe poder reconstruirse sumando estos movimientos.
// Customer.totalDebt / Supplier.totalDebt quedan como caché desnormalizado,
// nunca como fuente de verdad.
// =============================================

model CustomerAccountMovement {
  id          String    @id @default(cuid())
  companyId   String
  customerId  String
  date        DateTime  @default(now())
  type        String // INVOICE | PAYMENT | CREDIT_NOTE | DEBIT_NOTE | ADJUSTMENT
  debe        Decimal   @default(0) @db.Decimal(12, 2)
  haber       Decimal   @default(0) @db.Decimal(12, 2)
  balance     Decimal   @db.Decimal(12, 2) // saldo acumulado al momento del movimiento
  sourceType  String? // invoice | payment | sale | manual
  sourceId    String?
  dueDate     DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId, date])
  @@map("customer_account_movements")
}

model SupplierAccountMovement {
  id          String    @id @default(cuid())
  companyId   String
  supplierId  String
  date        DateTime  @default(now())
  type        String // PURCHASE | PAYMENT | CREDIT_NOTE | DEBIT_NOTE | ADJUSTMENT
  debe        Decimal   @default(0) @db.Decimal(12, 2)
  haber       Decimal   @default(0) @db.Decimal(12, 2)
  balance     Decimal   @db.Decimal(12, 2)
  sourceType  String? // purchase | payment | manual
  sourceId    String?
  dueDate     DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId, supplierId, date])
  @@map("supplier_account_movements")
}

// =============================================
// TESORERÍA FORMAL — Caja diaria, Bancos, Cheques
// =============================================

model CashRegister {
  id        String   @id @default(cuid())
  companyId String
  branchId  String?
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions CashSession[]

  @@map("cash_registers")
}

model CashSession {
  id             String    @id @default(cuid())
  cashRegisterId String
  userId         String
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  openingAmount  Decimal   @db.Decimal(12, 2)
  countedAmount  Decimal?  @db.Decimal(12, 2) // arqueo físico al cierre
  expectedAmount Decimal?  @db.Decimal(12, 2) // lo que el sistema calcula que debería haber
  difference     Decimal?  @db.Decimal(12, 2) // countedAmount - expectedAmount
  status         String    @default("OPEN") // OPEN | CLOSED
  notes          String?

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  closing      CashClosing?

  @@map("cash_sessions")
}

model CashClosing {
  id               String   @id @default(cuid())
  cashSessionId    String   @unique
  totalIncome      Decimal  @db.Decimal(12, 2)
  totalExpense     Decimal  @db.Decimal(12, 2)
  totalCash        Decimal  @db.Decimal(12, 2)
  totalCard        Decimal  @db.Decimal(12, 2)
  totalTransfer    Decimal  @db.Decimal(12, 2)
  totalMercadoPago Decimal  @db.Decimal(12, 2)
  totalCheck       Decimal  @db.Decimal(12, 2)
  closedById       String
  createdAt        DateTime @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@map("cash_closings")
}

model BankAccount {
  id            String   @id @default(cuid())
  companyId     String
  bankName      String
  accountNumber String?
  cbu           String?
  alias         String?
  currency      String   @default("ARS")
  balance       Decimal  @default(0) @db.Decimal(12, 2) // caché, reconstruible desde BankMovement
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements BankMovement[]

  @@map("bank_accounts")
}

model BankMovement {
  id            String    @id @default(cuid())
  bankAccountId String
  companyId     String
  date          DateTime  @default(now())
  type          String // DEPOSIT | WITHDRAWAL | TRANSFER | FEE | INTEREST
  amount        Decimal   @db.Decimal(12, 2) // positivo=ingreso, negativo=egreso
  balance       Decimal   @db.Decimal(12, 2) // saldo acumulado al momento del movimiento
  description   String
  reference     String?
  reconciled    Boolean   @default(false) // conciliación bancaria básica
  reconciledAt  DateTime?
  createdAt     DateTime  @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId, date])
  @@map("bank_movements")
}

model Check {
  id         String   @id @default(cuid())
  companyId  String
  type       String // RECEIVED | ISSUED
  number     String
  bankName   String?
  issueDate  DateTime
  dueDate    DateTime
  amount     Decimal  @db.Decimal(12, 2)
  status     String   @default("PENDING") // PENDING | DEPOSITED | CLEARED | REJECTED | DELIVERED
  customerId String?
  supplierId String?
  notes      String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("checks")
}

model CardSettlement {
  id          String    @id @default(cuid())
  companyId   String
  provider    String // Visa, Mastercard, etc.
  batchNumber String?
  amount      Decimal   @db.Decimal(12, 2)
  feeAmount   Decimal   @default(0) @db.Decimal(12, 2)
  netAmount   Decimal   @db.Decimal(12, 2)
  settledAt   DateTime?
  status      String    @default("PENDING") // PENDING | SETTLED
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("card_settlements")
}

model MercadoPagoTransaction {
  id         String   @id @default(cuid())
  companyId  String
  externalId String? // ID de la transacción en Mercado Pago
  amount     Decimal  @db.Decimal(12, 2)
  feeAmount  Decimal  @default(0) @db.Decimal(12, 2)
  netAmount  Decimal  @db.Decimal(12, 2)
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  saleId     String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("mercadopago_transactions")
}

// =============================================
// CÓDIGOS DE BARRA Y PACKAGING
// =============================================

model BarcodeAlias {
  id        String   @id @default(cuid())
  productId String
  barcode   String // EAN-13, EAN-8, UPC-A, GTIN-14/DUN-14
  type      String   @default("EAN13") // EAN13 | EAN8 | UPCA | GTIN14
  packaging String   @default("UNIT") // UNIT | BOX | PALLET — permite escanear la caja y vender la unidad
  quantity  Decimal  @default(1) @db.Decimal(12, 3) // cuántas unidades representa este código (ej: caja de 12)
  isActive  Boolean  @default(true)
