// =============================================
// DISTRIBUCIÓN Y REPARTO
// =============================================

model DeliveryRouteSheet {
  id        String         @id @default(cuid())
  routeId   String
  date      DateTime
  driverId  String?
  vehicle   String?
  status    String         @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
