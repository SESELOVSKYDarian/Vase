// =============================================
// REPORTES GUARDADOS Y IA
// =============================================

model SavedReport {
  id          String    @id @default(cuid())
  companyId   String
  userId      String
  name        String
  description String?
  entity      String // customers, sales, products, stock, etc.
  filters     Json? // filtros aplicados
  columns     Json? // columnas visibles
  orderBy     String?
  orderDir    String    @default("desc")
  groupBy     String?
  dateRange   String? // CURRENT_MONTH, LAST_MONTH, LAST_7_DAYS, CUSTOM, etc.
  dateFrom    DateTime?
  dateTo      DateTime?
  format      String    @default("TABLE") // TABLE, CHART, EXCEL, PDF
  chartType   String? // BAR, LINE, PIE, AREA
  isPublic    Boolean   @default(false)
  isScheduled Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id])
  schedules  SavedReportSchedule[]
  executions ReportExecution[]

  @@map("saved_reports")
}

model SavedReportSchedule {
  id         String      @id @default(cuid())
  reportId   String
  frequency  String // DAILY, WEEKLY, MONTHLY, CUSTOM
  dayOfWeek  Int? // 0=Sunday...6=Saturday
  dayOfMonth Int? // 1-31
  time       String? // "08:00"
  isActive   Boolean     @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime    @default(now())
  report     SavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("saved_report_schedules")
}

model ReportExecution {
  id        String      @id @default(cuid())
  reportId  String
  status    String      @default("RUNNING") // RUNNING, COMPLETED, FAILED
  rowCount  Int?
  duration  Int? // milliseconds
  error     String?
  exportUrl String?
  createdAt DateTime    @default(now())
  report    SavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_executions")
}

model AIReportRequest {
  id            String   @id @default(cuid())
  companyId     String
  userId        String
  prompt        String   @db.Text
  parsedIntent  Json? // intención parseada por IA
  status        String   @default("PENDING") // PENDING, CLARIFYING, READY, EXECUTED
  savedReportId String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@map("ai_report_requests")
}

