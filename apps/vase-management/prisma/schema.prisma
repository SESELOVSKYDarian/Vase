// prisma/schema.prisma
// Vase Business - ERP SaaS Argentino v2.0
// Schema completo expandido con todos los módulos ERP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// AUTENTICACIÓN Y USUARIOS
// =============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  isActive      Boolean   @default(true)
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  globalUserId  String?   @unique

  accounts         Account[]
  sessions         Session[]
  companyUsers     CompanyUser[]
  auditLogs        AuditLog[]
  createdSales     Sale[]                 @relation("SaleCreator")
  createdInvoices  Invoice[]              @relation("InvoiceCreator")
  savedReports     SavedReport[]
  aiReportRequests AIReportRequest[]
  authorizations   AuthorizationRequest[] @relation("AuthorizationRequester")
  approvedAuths    AuthorizationRequest[] @relation("AuthorizationApprover")
  systemAlerts     SystemAlert[]
  closingProcesses ClosingProcess[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ManagementSsoNonce {
  id        String   @id @default(cuid())
  nonceHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([expiresAt, usedAt])
  @@map("management_sso_nonces")
}

model ManagementSyncOutbox {
  id            String   @id @default(cuid())
  eventId       String   @unique
  companyId     String
  globalTenantId String
  destination   String
  entity        String
  action        String
  externalId    String
  version       Int
  payload       Json
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([globalTenantId, entity, externalId, version])
  @@map("management_sync_outbox")
}

model ManagementSyncReceipt {
  id             String   @id @default(cuid())
  eventId        String   @unique
  companyId      String
  globalTenantId String
  entity         String
  externalId     String
  version        Int
  processedAt    DateTime @default(now())

  @@index([globalTenantId, entity, externalId, version])
  @@map("management_sync_receipts")
}

// =============================================
// ROLES Y PERMISOS
// =============================================

model Role {
  id           String           @id @default(cuid())
  name         String           @unique
  description  String?
  isSystem     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  permissions  RolePermission[]
  companyUsers CompanyUser[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  module      String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================
// EMPRESAS Y CONFIGURACIÓN
// =============================================

model Company {
  id              String       @id @default(cuid())
  name            String
  legalName       String?
  cuit            String?
  address         String?
  city            String?
  province        String?
  postalCode      String?
  phone           String?
  email           String?
  website         String?
  logo            String?
  ivaCondition    IvaCondition @default(RESPONSABLE_INSCRIPTO)
  plan            PlanType     @default(BASIC)
  isActive        Boolean      @default(true)
  suspendedAt     DateTime?
  suspendedReason String?
  trialEndsAt     DateTime?
  settings        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  globalTenantId  String?      @unique
  integrationProvider String   @default("EXTERNAL_API")
  provisioningStatus String    @default("PENDING")
  lastSyncAt      DateTime?
  lastSyncError   String?

  branches           Branch[]
  companyUsers       CompanyUser[]
  customers          Customer[]
  suppliers          Supplier[]
  categories         Category[]
  brands             Brand[]
  products           Product[]
  warehouses         Warehouse[]
  stockMovements     StockMovement[]
  sales              Sale[]
  invoices           Invoice[]
  purchases          Purchase[]
  cashMovements      CashMovement[]
  auditLogs          AuditLog[]
  priceLists         PriceList[]
  savedReports       SavedReport[]
  systemAlerts       SystemAlert[]
  fiscalPeriods      FiscalPeriod[]
  closingProcesses   ClosingProcess[]
  backupLogs         BackupLog[]
  salesZones         SalesZone[]
  customerGroups     CustomerGroup[]
  deliveryRoutes     DeliveryRoute[]
  productSections    ProductSection[]
  productFamilies    ProductFamily[]
  productGroups      ProductGroup[]
  warehouseTransfers WarehouseTransfer[]
  fiscalCertificates FiscalCertificate[]
  afipRequestLogs    AfipRequestLog[]
  afipErrorLogs      AfipErrorLog[]
  cashRegisters      CashRegister[]
  bankAccounts       BankAccount[]
  checks             Check[]
  cardSettlements    CardSettlement[]
  mercadoPagoTx      MercadoPagoTransaction[]
  posSessions        PosSession[]
  planOverride       PlanOverride?
  usageMetrics       UsageMetric[]
  subscriptionEvents SubscriptionEvent[]
  automationRules    AutomationRule[]
  offlineSyncQueue   OfflineSyncQueue[]
  warehouseSectors          WarehouseSector[]
  warehouseProductLocations WarehouseProductLocation[]
  warehouseProductImages    WarehouseProductImage[]
  warehouseDevices          WarehouseDevice[]
  warehouseLedCommands      WarehouseLedCommand[]
  warehouseConversationLogs WarehouseConversationLog[]
  warehouseChannels         WarehouseChannel[]

  @@map("companies")
}

model Branch {
  id           String        @id @default(cuid())
  companyId    String
  name         String
  address      String?
  phone        String?
  isMain       Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pointsOfSale PointOfSale[]
  sales        Sale[]

  @@map("branches")
}

model PointOfSale {
  id           String    @id @default(cuid())
  branchId     String
  number       Int
  name         String?
  isActive     Boolean   @default(true)
  lastInvoiceA Int       @default(0)
  lastInvoiceB Int       @default(0)
  lastInvoiceC Int       @default(0)
  lastInvoiceM Int       @default(0)
  lastInvoiceE Int       @default(0)
  createdAt    DateTime  @default(now())
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@unique([branchId, number])
  @@map("points_of_sale")
}

model CompanyUser {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  roleId    String?
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?    @relation(fields: [roleId], references: [id])

  @@unique([companyId, userId])
  @@map("company_users")
}

// =============================================
// ZONAS, GRUPOS Y SEGMENTACIÓN
// =============================================

model SalesZone {
  id          String     @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers   Customer[]

  @@map("sales_zones")
}

model CustomerGroup {
  id          String     @id @default(cuid())
  companyId   String
  name        String
  description String?
  discount    Decimal    @default(0) @db.Decimal(5, 2)
  priceListId String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers   Customer[]

  @@map("customer_groups")
}

model DeliveryRoute {
  id          String               @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers   Customer[]
  routeSheets DeliveryRouteSheet[]

  @@map("delivery_routes")
}

// =============================================
// CLIENTES AVANZADO
// =============================================

model Customer {
  id              String       @id @default(cuid())
  companyId       String
  code            String?
  name            String
  firstName       String?
  lastName        String?
  documentType    DocumentType @default(CUIT)
  documentNumber  String?
  ivaCondition    IvaCondition @default(CONSUMIDOR_FINAL)
  email           String?
  phone           String?
  mobile          String?
  address         String?
  city            String?
  province        String?
  postalCode      String?
  birthDate       DateTime?
  creditLimit     Decimal      @default(0) @db.Decimal(12, 2)
  creditRisk      CreditRisk   @default(BAJO)
  totalDebt       Decimal      @default(0) @db.Decimal(12, 2)
  lastInvoiceDate DateTime?
  groupId         String?
  zoneId          String?
  deliveryRouteId String?
  sector          String?
  activity        String?
  notes           String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  globalExternalId String?
  sourceVersion    Int          @default(1)

  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group            CustomerGroup?            @relation(fields: [groupId], references: [id])
  zone             SalesZone?                @relation(fields: [zoneId], references: [id])
  deliveryRoute    DeliveryRoute?            @relation(fields: [deliveryRouteId], references: [id])
  sales            Sale[]
  invoices         Invoice[]
  messages         CustomerMessage[]
  accountMovements CustomerAccountMovement[]

  @@unique([companyId, globalExternalId])
  @@map("customers")
}

model CustomerMessage {
  id         String   @id @default(cuid())
  customerId String
  content    String   @db.Text
  type       String   @default("NOTE") // NOTE, WARNING, ALERT
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_messages")
}

// =============================================
// PROVEEDORES AVANZADO
// =============================================

model Supplier {
  id              String       @id @default(cuid())
  companyId       String
  code            String?
  name            String
  contactName     String?
  documentType    DocumentType @default(CUIT)
  documentNumber  String?
  ivaCondition    IvaCondition @default(RESPONSABLE_INSCRIPTO)
  email           String?
  phone           String?
  mobile          String?
  address         String?
  city            String?
  province        String?
  paymentTermDays Int          @default(30)
  creditLimit     Decimal      @default(0) @db.Decimal(12, 2)
  totalDebt       Decimal      @default(0) @db.Decimal(12, 2)
  notes           String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases        Purchase[]
  accountMovements SupplierAccountMovement[]

  @@map("suppliers")
}

// =============================================
// PRODUCTOS - ESTRUCTURA AVANZADA
// =============================================

model ProductSection {
  id        String          @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  families  ProductFamily[]

  @@map("product_sections")
}

model ProductFamily {
  id        String          @id @default(cuid())
  companyId String
  sectionId String?
  name      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  section   ProductSection? @relation(fields: [sectionId], references: [id])
  products  Product[]
  groups    ProductGroup[]

  @@map("product_families")
}

model ProductGroup {
  id        String         @id @default(cuid())
  companyId String
  familyId  String?
  name      String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  family    ProductFamily? @relation(fields: [familyId], references: [id])
  products  Product[]

  @@map("product_groups")
}

model Category {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  color       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]

  @@map("brands")
}

model Product {
  id              String   @id @default(cuid())
  companyId       String
  categoryId      String?
  brandId         String?
  familyId        String?
  groupId         String?
  code            String?
  barcode         String?
  name            String
  description     String?
  unit            String   @default("UN")
  price           Decimal  @db.Decimal(12, 2)
  cost            Decimal  @default(0) @db.Decimal(12, 2)
  ivaRate         Decimal  @default(21) @db.Decimal(5, 2)
  stock           Decimal  @default(0) @db.Decimal(12, 3)
  minStock        Decimal  @default(0) @db.Decimal(12, 3)
  maxStock        Decimal  @default(0) @db.Decimal(12, 3)
  hasSerialNumber Boolean  @default(false)
  hasBatchControl Boolean  @default(false)
  hasExpiry       Boolean  @default(false)
  hasVariants     Boolean  @default(false)
  isComposite     Boolean  @default(false)
  warrantyDays    Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  globalExternalId String?
  sourceVersion    Int      @default(1)

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category                 Category?                 @relation(fields: [categoryId], references: [id])
  brand                    Brand?                    @relation(fields: [brandId], references: [id])
  family                   ProductFamily?            @relation(fields: [familyId], references: [id])
  group                    ProductGroup?             @relation(fields: [groupId], references: [id])
  stockMovements           StockMovement[]
  saleItems                SaleItem[]
  purchaseItems            PurchaseItem[]
  priceListItems           PriceListItem[]
  batches                  ProductBatch[]
  serialNumbers            ProductSerialNumber[]
  variants                 ProductVariant[]
  stockLevels              StockLevel[]
  barcodeAliases           BarcodeAlias[]
  warehouseTransferItems   WarehouseTransferItem[]
  inventoryAdjustmentItems InventoryAdjustmentItem[]
  warehouseLocations       WarehouseProductLocation[]

  @@unique([companyId, globalExternalId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String // e.g. "Talle M / Rojo"
  sku       String?
  color     String?
  size      String?
  price     Decimal? @db.Decimal(12, 2)
  cost      Decimal? @db.Decimal(12, 2)
  stock     Decimal  @default(0) @db.Decimal(12, 3)
  barcode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductBatch {
  id              String    @id @default(cuid())
  productId       String
  batchNumber     String
  quantity        Decimal   @db.Decimal(12, 3)
  expiryDate      DateTime?
  manufactureDate DateTime?
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_batches")
}

model ProductSerialNumber {
  id           String    @id @default(cuid())
  productId    String
  serialNumber String
  status       String    @default("AVAILABLE") // AVAILABLE, SOLD, RETURNED
  saleItemId   String?
  purchaseDate DateTime?
  soldDate     DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_serial_numbers")
}

// =============================================
// STOCK AVANZADO - ALMACENES Y NIVELES
// =============================================

model Warehouse {
  id                   String                @id @default(cuid())
  companyId            String
  name                 String
  address              String?
  isMain               Boolean               @default(false)
  isVirtual            Boolean               @default(false)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  transfersOut         WarehouseTransfer[]   @relation("TransferFrom")
  transfersIn          WarehouseTransfer[]   @relation("TransferTo")
  inventoryAdjustments InventoryAdjustment[]
  warehouseProductLocations WarehouseProductLocation[]

  @@map("warehouses")
}

model StockLevel {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  reserved    Decimal   @default(0) @db.Decimal(12, 3)
  available   Decimal   @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id           String            @id @default(cuid())
  companyId    String
  warehouseId  String?
  productId    String
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  unitCost     Decimal?          @db.Decimal(12, 2)
  reference    String?
  notes        String?
  saleId       String?
  purchaseId   String?
  batchNumber  String?
  serialNumber String?
  date         DateTime          @default(now())
  createdAt    DateTime          @default(now())
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?        @relation(fields: [warehouseId], references: [id])
  product      Product           @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model WarehouseTransfer {
  id              String                  @id @default(cuid())
  companyId       String
  fromWarehouseId String
  toWarehouseId   String
  status          String                  @default("PENDING") // PENDING, COMPLETED, CANCELLED
  notes           String?
  date            DateTime                @default(now())
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWarehouse   Warehouse               @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse               @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items           WarehouseTransferItem[]

  @@map("warehouse_transfers")
}

model WarehouseTransferItem {
  id         String            @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal           @db.Decimal(12, 3)
  transfer   WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id])

  @@map("warehouse_transfer_items")
}

model InventoryAdjustment {
  id           String                    @id @default(cuid())
  companyId    String
  warehouseId  String?
  reason       String // DAMAGE, EXPIRY, LOSS, COUNT, OTHER
  notes        String?
  status       String                    @default("DRAFT") // DRAFT, APPROVED, APPLIED
  approvedById String?
  date         DateTime                  @default(now())
  createdAt    DateTime                  @default(now())
  warehouse    Warehouse?                @relation(fields: [warehouseId], references: [id])
  items        InventoryAdjustmentItem[]

  @@map("inventory_adjustments")
}

model InventoryAdjustmentItem {
  id           String              @id @default(cuid())
  adjustmentId String
  productId    String
  expectedQty  Decimal             @db.Decimal(12, 3)
  actualQty    Decimal             @db.Decimal(12, 3)
  difference   Decimal             @db.Decimal(12, 3)
  adjustment   InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id])

  @@map("inventory_adjustment_items")
}

// =============================================
// LISTAS DE PRECIOS
// =============================================

model PriceList {
  id          String          @id @default(cuid())
  companyId   String
  name        String
  description String?
  isDefault   Boolean         @default(false)
  isTaxIncl   Boolean         @default(true)
  discount    Decimal         @default(0) @db.Decimal(5, 2)
  markup      Decimal         @default(0) @db.Decimal(5, 2)
  currency    String          @default("ARS")
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  productId   String
  price       Decimal   @db.Decimal(12, 2)
  updatedAt   DateTime  @updatedAt
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

// =============================================
// VENTAS AVANZADAS (Presupuesto → Pedido → Remito → Factura)
// =============================================

model Sale {
  id                 String     @id @default(cuid())
  companyId          String
  branchId           String?
  customerId         String?
  userId             String?
  type               SaleType   @default(SALE)
  status             SaleStatus @default(DRAFT)
  number             String?
  date               DateTime   @default(now())
  dueDate            DateTime?
  deliveryDate       DateTime?
  subtotal           Decimal    @db.Decimal(12, 2)
  discountPct        Decimal    @default(0) @db.Decimal(5, 2)
  discountAmt        Decimal    @default(0) @db.Decimal(12, 2)
  ivaAmount          Decimal    @default(0) @db.Decimal(12, 2)
  total              Decimal    @db.Decimal(12, 2)
  paidAmount         Decimal    @default(0) @db.Decimal(12, 2)
  balance            Decimal    @default(0) @db.Decimal(12, 2)
  notes              String?
  cancellationReason String?
  priceListId        String?
  convertedFromId    String? // ID de presupuesto/pedido origen
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  globalExternalId   String?
  sourceVersion      Int        @default(1)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  user          User?          @relation("SaleCreator", fields: [userId], references: [id])
  items         SaleItem[]
  invoices      Invoice[]
  payments      Payment[]
  deliveryStops DeliveryStop[]

  @@unique([companyId, globalExternalId])
  @@map("sales")
}

model SaleItem {
  id           String  @id @default(cuid())
  saleId       String
  productId    String
  description  String?
  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(12, 2)
  discountPct  Decimal @default(0) @db.Decimal(5, 2)
  ivaRate      Decimal @default(21) @db.Decimal(5, 2)
  subtotal     Decimal @db.Decimal(12, 2)
  ivaAmount    Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)
  batchNumber  String?
  serialNumber String?
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

// =============================================
// FACTURACIÓN (AFIP/ARCA)
// =============================================

model Invoice {
  id                 String        @id @default(cuid())
  companyId          String
  saleId             String?
  customerId         String?
  userId             String?
  pointOfSaleId      String?
  type               InvoiceType   @default(INVOICE)
  letter             InvoiceLetter @default(B)
  number             Int
  date               DateTime      @default(now())
  dueDate            DateTime?
  subtotal           Decimal       @db.Decimal(12, 2)
  ivaAmount          Decimal       @default(0) @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  paidAmount         Decimal       @default(0) @db.Decimal(12, 2)
  balance            Decimal       @default(0) @db.Decimal(12, 2)
  cae                String?
  caeDueDate         String?
  qrCode             String?       @db.Text
  status             InvoiceStatus @default(PENDING)
  cancellationReason String?
  relatedInvoiceId   String? // para CREDIT_NOTE/DEBIT_NOTE: factura original que se está corrigiendo
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale           Sale?         @relation(fields: [saleId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  user           User?         @relation("InvoiceCreator", fields: [userId], references: [id])
  pointOfSale    PointOfSale?  @relation(fields: [pointOfSaleId], references: [id])
  relatedInvoice Invoice?      @relation("InvoiceCorrections", fields: [relatedInvoiceId], references: [id])
  correctedBy    Invoice[]     @relation("InvoiceCorrections")
  items          InvoiceItem[]
  payments       Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  ivaRate     Decimal @default(21) @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  ivaAmount   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// =============================================
// COMPRAS
