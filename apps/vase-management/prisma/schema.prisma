  @@map("pos_sessions")
}

model PosSale {
  id            String   @id @default(cuid())
  posSessionId  String
  saleId        String   @unique
  paymentSplits Json // [{method: 'CASH', amount: 1000}, {method: 'CARD', amount: 500}]
  createdAt     DateTime @default(now())

  posSession PosSession @relation(fields: [posSessionId], references: [id], onDelete: Cascade)

  @@map("pos_sales")
}

enum PeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

// =============================================
// SAAS — PLANES, LÍMITES Y MÉTRICAS
// =============================================

// Catálogo de planes con sus límites — vive en código (PLAN_LIMITS en
// lib/plan-limits.ts), este modelo es solo para permitir overrides puntuales
// por empresa (ej: cliente ENTERPRISE con un límite custom negociado)
// sin tener que crear un plan nuevo para un caso único.
model PlanOverride {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  maxUsers            Int?
  maxInvoicesPerMonth Int?
  maxProducts         Int?
  maxCustomers        Int?
  maxStorageMb        Int?
  reason              String?
  createdAt           DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("plan_overrides")
}

model UsageMetric {
  id            String   @id @default(cuid())
  companyId     String
  date          DateTime @default(now()) // día al que corresponde la métrica (snapshot diario)
  activeUsers   Int      @default(0)
  invoiceCount  Int      @default(0)
  salesCount    Int      @default(0)
  salesAmount   Decimal  @default(0) @db.Decimal(14, 2)
  productCount  Int      @default(0)
  customerCount Int      @default(0)
  storageMb     Int      @default(0)
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@map("usage_metrics")
}

model SubscriptionEvent {
  id          String   @id @default(cuid())
  companyId   String
  type        String // PLAN_CHANGE | SUSPENDED | REACTIVATED | TRIAL_STARTED | TRIAL_ENDED | CANCELLED
  fromPlan    String?
  toPlan      String?
  reason      String?
  performedBy String? // userId del super admin que lo hizo, si aplica
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscription_events")
}

// =============================================
// AUTOMATIZACIONES
// =============================================

model AutomationRule {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  trigger     String // LOW_STOCK | INVOICE_OVERDUE | NEW_CUSTOMER | PRODUCT_EXPIRING | CREDIT_LIMIT_EXCEEDED | SALE_CREATED
  conditions  Json? // filtros opcionales sobre el trigger, ej: {minAmount: 10000}
  actions     Json // array de acciones: [{type: 'CREATE_ALERT', ...}, {type: 'WEBHOOK', url: '...'}, {type: 'SEND_EMAIL', ...}]
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  runCount    Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  logs    AutomationLog[]

  @@map("automation_rules")
}

model AutomationLog {
  id          String   @id @default(cuid())
  ruleId      String
  triggeredBy String? // entityType:entityId que disparó la regla
  status      String // SUCCESS | FAILED | SKIPPED
  actionsRun  Json?
  error       String?
  createdAt   DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("automation_logs")
}

// =============================================
// TRAZABILIDAD OFFLINE POS
// =============================================

// Cola de ventas generadas offline en el cliente (POS sin conexión) que
// se sincronizan cuando vuelve la red. clientTxId es generado en el
// dispositivo (UUID) y garantiza idempotencia: reenviar la misma venta
// dos veces por una reconexión no duplica el registro.
model OfflineSyncQueue {
  id         String    @id @default(cuid())
  companyId  String
  clientTxId String    @unique
  payload    Json // el mismo shape que espera POST /api/pos/venta
  status     String    @default("PENDING") // PENDING | SYNCED | FAILED
  saleId     String? // se completa cuando se sincroniza exitosamente
  error      String?
  createdAt  DateTime  @default(now()) // timestamp del dispositivo (offline)
  syncedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("offline_sync_queue")
}

// =============================================
// WAREHOUSE AI (DEPOSITO IA)
// =============================================

enum WarehouseProductImageType {
  PRODUCT
  BOX
  RACK
  SECTOR
}

enum WarehouseDeviceType {
  ESP32_LED_STRIP
}

enum WarehouseLedCommandStatus {
  PENDING
  CLAIMED
  DONE
  FAILED
  EXPIRED
}

enum WarehouseConversationChannel {
  WEB
  TELEGRAM
  WHATSAPP
  API
}

enum WarehouseConversationMessageType {
  TEXT
  AUDIO
  IMAGE
}

model WarehouseSector {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  normalizedName String
  description    String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations WarehouseProductLocation[]

  @@unique([companyId, normalizedName])
  @@map("warehouse_sectors")
}

model WarehouseProductLocation {
  id           String   @id @default(cuid())
  companyId    String
  productId    String
  warehouseId  String?
  sectorId     String
  rack         String
  row          String
  box          String?
  observations String?
  imageUrl     String?
  ledNumber    Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id])
  sector    WarehouseSector @relation(fields: [sectorId], references: [id])
  
  images      WarehouseProductImage[]
  ledCommands WarehouseLedCommand[]

  @@unique([companyId, productId])
  @@map("warehouse_product_locations")
}

model WarehouseProductImage {
  id                String                    @id @default(cuid())
  companyId         String
  productLocationId String
  url               String
  providerFileId    String?
  type              WarehouseProductImageType @default(PRODUCT)
  description       String?
  createdAt         DateTime                  @default(now())

  company         Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productLocation WarehouseProductLocation @relation(fields: [productLocationId], references: [id], onDelete: Cascade)

  @@index([productLocationId])
  @@map("warehouse_product_images")
}

model WarehouseDevice {
  id            String              @id @default(cuid())
  companyId     String
  name          String
  deviceKey     String              @unique
  type          WarehouseDeviceType @default(ESP32_LED_STRIP)
  status        String              @default("OFFLINE")
  lastSeenAt    DateTime?
  ledCount      Int                 @default(60)
  brightness    Int                 @default(255)
  maxActiveLeds Int                 @default(10)
  serverBaseUrl String?
  wifiSsid      String?
  wifiPassword  String?
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledCommands WarehouseLedCommand[]

  @@map("warehouse_devices")
}

model WarehouseLedCommand {
  id                String                    @id @default(cuid())
  companyId         String
  deviceId          String
  productLocationId String?
  ledNumber         Int
  activeCount       Int                       @default(1)
  color             Json                      // { r: 0, g: 255, b: 0 }
  durationMs        Int                       @default(5000)
  status            WarehouseLedCommandStatus @default(PENDING)
  createdAt         DateTime                  @default(now())
  claimedAt         DateTime?
  completedAt       DateTime?
  expiresAt         DateTime?
  lastError         String?

  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device          WarehouseDevice           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  productLocation WarehouseProductLocation? @relation(fields: [productLocationId], references: [id])

  @@index([deviceId, status])
  @@map("warehouse_led_commands")
}

model WarehouseConversationLog {
  id             String                           @id @default(cuid())
  companyId      String
  channel        WarehouseConversationChannel
  externalUserId String?
  messageType    WarehouseConversationMessageType @default(TEXT)
  transcript     String?
  intent         String?
  payload        Json?
  createdAt      DateTime                         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("warehouse_conversation_logs")
}

enum WarehouseWebhookEventStatus {
  PROCESSING
  DONE
  FAILED
}

model WarehouseChannel {
  id                String                       @id @default(cuid())
  companyId         String
  type              WarehouseConversationChannel
  providerAccountId String?                      // Phone number ID for WhatsApp, Bot ID for Telegram
  wabaId            String?                      // WhatsApp Business Account ID
  metaAppId         String?                      // Meta App ID
  accessToken       String?                      @db.Text
  verifyToken       String?                      @db.Text
  secretToken       String?                      @db.Text
  webhookUrl        String?                      @db.Text
  active            Boolean                      @default(true)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  WarehouseWebhookEvent[]

  @@unique([companyId, type])
  @@map("warehouse_channels")
}

model WarehouseWebhookEvent {
  id                String                      @id @default(cuid())
  channelId         String
  providerMessageId String?
  status            WarehouseWebhookEventStatus @default(PROCESSING)
  payload           Json?
  error             String?                     @db.Text
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  channel WarehouseChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, providerMessageId])
  @@index([channelId, status])
  @@map("warehouse_webhook_events")
}

