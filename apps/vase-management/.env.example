# Copy to .env.local for local development or configure as runtime variables
# in EasyPanel. Never commit real secrets.

# Management owns this PostgreSQL database. Vase App remains on its separate DB.
DATABASE_URL=postgresql://vase_management_user:PASSWORD@postgres-management:5432/vase_management

# Central authentication
# AUTH_SECRET and SERVICE_TO_SERVICE_TOKEN must each use the same generated
# value as their corresponding variable in Vase App.
AUTH_SECRET=
SERVICE_TO_SERVICE_TOKEN=

# EasyPanel/internal service URL. Local override: http://localhost:3002
APP_INTERNAL_URL=http://vase-app:3002

# Public production URLs. Local overrides are http://localhost:3002 and
# http://localhost:3006 respectively.
VASE_APP_PUBLIC_URL=https://app.vase.ar
NEXT_PUBLIC_VASE_APP_URL=https://app.vase.ar
NEXT_PUBLIC_APP_URL=https://management.vase.ar
NEXT_PUBLIC_APP_NAME=Vase Management

# Optional AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Protects /api/reportes/procesar-programados. Generate separately.
CRON_SECRET=

# AFIP/ARCA Web Services. Sandbox works without production certificates.
AFIP_CERT=
AFIP_KEY=
AFIP_CUIT=
AFIP_ENV=sandbox

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vase.ar

# Other internal Vase services
BUSINESS_INTERNAL_URL=http://vase-business:3005
LABS_INTERNAL_URL=http://vase-labs:3007
