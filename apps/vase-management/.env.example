# .env.example
# Copiar a .env.local y completar con valores reales

# Base de datos PostgreSQL
DATABASE_URL=postgresql://vase_management_user:PASSWORD@postgres-management:5432/vase_management

# NextAuth / Auth.js
NEXTAUTH_SECRET="generar-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# IA (opcional - para integración futura)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Groq (IA gratuita - usada por el Asistente IA y Generador de Reportes)
# Obtené tu clave gratis en https://console.groq.com
GROQ_API_KEY=""

# Cron externo — protege /api/reportes/procesar-programados de ejecuciones
# no autorizadas. Generar con: openssl rand -hex 32
CRON_SECRET=""

# AFIP/ARCA Web Services (dejar vacío - usa mock en desarrollo)
AFIP_CERT=""
AFIP_KEY=""
AFIP_CUIT=""
AFIP_ENV="sandbox"

# Email (opcional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@vase.com"

# Storage (opcional - para imágenes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Vase Business"
VASE_APP_INTERNAL_URL="http://localhost:3001"
MANAGEMENT_SSO_SECRET=""
SERVICE_TO_SERVICE_TOKEN=""
BUSINESS_INTERNAL_URL="http://localhost:3005"
LABS_INTERNAL_URL="http://localhost:3007"
