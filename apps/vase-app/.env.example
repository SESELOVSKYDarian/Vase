NODE_ENV=development
HOSTNAME=0.0.0.0
PORT=3002
DATABASE_URL=mysql://mysql:local-development-password@localhost:3306/vase
NEXT_PUBLIC_PUBLIC_SITE_ORIGIN=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002
VASE_ADMIN_PUBLIC_URL=http://admin.localhost:3002
NEXT_PUBLIC_LABS_URL=http://localhost:3007
# Production: .vase.ar shares the authoritative Vase App session with every
# Vase subdomain, including management.vase.ar. For local development, leave
# this empty in .env.local so the cookie remains host-only.
AUTH_COOKIE_DOMAIN=.vase.ar
TRUSTED_ORIGINS=http://localhost:3002,http://admin.localhost:3002,http://127.0.0.1:3002
VASE_PRIMARY_HOST=localhost:3002
VASE_ADMIN_HOST=admin.localhost:3002
VASE_LABS_HOST=localhost:3007
# Production: generate outside the repository; use the same value in Vase App and Vase Management.
# A local-only value may be used in .env.local.
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=local-only-encryption-key-32-bytes
VASE_BUSINESS_SSO_SECRET=local-only-business-sso-secret
VASE_BUSINESS_SSO_ISSUER=vase-app
VASE_BUSINESS_SSO_AUDIENCE=vase-business
BUSINESS_EDITOR_URL=http://localhost:3000/admin/evolution

# Optional deployment identity
NEXT_DEPLOYMENT_ID=
MONITORING_TOKEN=
# Generate outside the repository. Use the same value in Vase App and Vase
# Management so Management can resolve its central session context.
SERVICE_TO_SERVICE_TOKEN=
LABS_INTERNAL_URL=http://vase-labs:3007
REST_INTERNAL_URL=http://vase-rest:3009
REST_CONTEXT_SIGNING_SECRET=local-only-rest-context-signing-secret

# Optional bootstrap accounts
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
TEST_TENANT_SLUG=
TEST_TENANT_NAME=

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
AUTH_FROM_EMAIL=noreply@vase.ar
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional AI configuration
AI_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_SUMMARY_MODEL=
VASE_API_KEY=

# Optional uploads and malware scanning
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_SCAN_MODE=report_only
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=
STORAGE_BUCKET=vase-private
UPLOADS_BASE_URL=
UPLOADS_JWT_SECRET=
MANAGEMENT_INTERNAL_URL=http://localhost:3006
# Production entry point for the Management application.
MANAGEMENT_PUBLIC_URL=https://management.vase.ar
MANAGEMENT_SSO_SECRET=
