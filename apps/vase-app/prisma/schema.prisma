model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  platformRole  PlatformRole @default(USER)
  locale        String       @default("es")
  passwordChangedAt DateTime?
  lastLoginAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[] @relation("MembershipUser")
  createdMemberships Membership[] @relation("MembershipCreatedBy")
  auditLogs     AuditLog[]   @relation("AuditActor")
  authTokens    AuthToken[]
  createdSupportTickets SupportTicket[] @relation("SupportTicketCreatedBy")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignedTo")
  supportNotes  SupportTicketNote[] @relation("SupportNoteAuthor")
  supportTemplates SupportReplyTemplate[] @relation("SupportTemplateAuthor")
  supportNotifications SupportNotification[] @relation("SupportNotificationRecipient")
  supportTicketEvents SupportTicketEvent[] @relation("SupportTicketActor")
  supportKnowledgeItems SupportKnowledgeItem[] @relation("SupportKnowledgeCreatedBy")
  supportTicketSubtasksAssigned SupportTicketSubtask[] @relation("SupportSubtaskAssignee")
  supportTicketSubtasksCreated  SupportTicketSubtask[] @relation("SupportSubtaskCreator")
  supportTicketWorklogs         SupportTicketWorklog[]
  supportTicketAssignments      SupportTicketAssignee[]
  supportAiResponseLogs SupportAiResponseLog[] @relation("SupportAiResponseRequestedBy")
  supportAiConversations SupportAiConversation[] @relation("SupportAiConversationUser")
  supportAiMessages      SupportAiMessage[]      @relation("SupportAiMessageUser")
  createdCustomQuotes CustomQuote[] @relation("CustomQuoteCreatedBy")
  updatedCustomQuotes CustomQuote[] @relation("CustomQuoteUpdatedBy")
  customQuoteRevisions CustomQuoteRevision[] @relation("CustomQuoteRevisionActor")
  productReviews ProductReview[]
  priceListAssignments UserPriceList[]
  placedOrders   Order[]         @relation("OrderPlacedBy")
  platformUpdateReads PlatformUpdateRead[]
  adminNotificationReads AdminNotificationRead[]
  systemNotificationReads SystemNotificationRead[]
  shortcuts     Json?
  clientAccessConfig Json?
  isDisabled    Boolean      @default(false)
  disabledAt    DateTime?
  disabledReason String?
  forcePasswordChange Boolean @default(false)
  tempPasswordIssuedAt DateTime?
  canceledSubscriptions TenantSubscription[] @relation("SubscriptionCanceledBy")
  wikiDocsCreated WikiDocument[] @relation("WikiDocumentAuthor")
  wikiRevisions  WikiRevision[] @relation("WikiRevisionAuthor")
  createdAdminNotifications AdminNotification[]
  adminAccessPolicy AdminAccessPolicy?
  internalProfile   InternalUserProfile?
  assignedDevTasks  DevTask[] @relation("DevTaskAssignee")
  createdDevTasks   DevTask[] @relation("DevTaskCreator")
  devTaskComments   DevTaskComment[]
  availabilityLogsChanged AvailabilityLog[] @relation("AvailabilityChangedBy")
  availabilityLogsActor   AvailabilityLog[] @relation("AvailabilityActor")
  supportQueuePolicies     SupportQueuePolicy[] @relation("SupportQueuePolicyUpdatedBy")
  managedClientAccounts    ClientAccount[] @relation("ClientAccountManager")
  createdClientPayments    ClientPayment[] @relation("ClientPaymentCreator")
  paymentAllocations       PaymentAllocation[] @relation("PaymentAllocationPartner")
  createdExpenses          Expense[] @relation("ExpenseCreator")
  developerTaskAssignments DevTaskAssignmentHistory[] @relation("DevTaskAssignmentActor")
  moduleArtifactsCreated   ModuleArtifact[]           @relation("ModuleArtifactCreatedBy")
  tenantInvitations        TenantInvitation[]
  appRoles                UserRole[]
  moduleAccesses          UserModuleAccess[]
  projectAssignments      ProjectAssignee[]
  projectUpdates          ProjectUpdate[]
  projectsCreated         Project[]                   @relation("ProjectCreatedBy")
  projectProcessUpdates   ProjectProcess[]
  managementIdentityLinks ManagementIdentityLink[]
  managementSsoNonces     ManagementSsoNonce[]
}

model AdminAccessPolicy {
  id               String   @id @default(cuid())
  userId           String   @unique
  canManageUsers   Boolean  @default(false)
  canManageBilling Boolean  @default(false)
  canManageFaqs    Boolean  @default(false)
  canManageWiki    Boolean  @default(false)
  canViewAudit     Boolean  @default(false)
  canManageNotifications Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tenant {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  accountName       String
  billingEmail      String?
  industry          String
  onboardingProduct OnboardingProduct @default(BUSINESS)
  status            TenantStatus      @default(TRIAL)
  locale            String            @default("es")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  memberships       Membership[]
  projects          Project[]
  featureFlags      FeatureFlag[]
  tenantModules     TenantModule[]
  featureGrants     TenantFeatureGrant[]
  invitations       TenantInvitation[]
  auditLogs         AuditLog[]
  subscription      TenantSubscription?
  storefrontPages   StorefrontPage[]
  customPageRequests CustomPageRequest[]
  customProjectMilestones CustomProjectMilestone[]
  customProjectMeetings CustomProjectMeeting[]
  domainConnections DomainConnection[]
  integrationApiCredentials IntegrationApiCredential[]
  integrationUsageLogs IntegrationUsageLog[]
  integrationWebhooks IntegrationWebhookEndpoint[]
  aiWorkspace       TenantAiWorkspace?
  aiKnowledgeItems  AiKnowledgeItem[]
  aiTrainingJobs    AiTrainingJob[]
  aiChannels        AiChannelConnection[]
  aiConversations   AiConversation[]
  supportTickets    SupportTicket[]
  supportTemplates  SupportReplyTemplate[]
  supportNotifications SupportNotification[]
  supportKnowledgeItems SupportKnowledgeItem[]
  supportAiResponseLogs SupportAiResponseLog[]
  supportAiConversations SupportAiConversation[]
  supportAiMessages      SupportAiMessage[]
  customQuotes      CustomQuote[]
  categories        Category[]
  products          Product[]
  productReviews    ProductReview[]
  productCollections ProductCollection[]
  priceLists        PriceList[]
  userPriceLists    UserPriceList[]
  productPriceOverrides ProductPriceOverride[]
  tenantOffers      TenantOffer[]
  shippingBranches  ShippingBranch[]
  shippingZones     ShippingZone[]
  orders            Order[]
  payments          Payment[]
  erpConnections    ErpConnection[]
  syncJobs          SyncJob[]
  productSyncRecords ProductSyncRecord[]
  adminNotifications AdminNotification[]
  systemNotificationReads SystemNotificationRead[]
  clientAccounts     ClientAccount[]
  financialSnapshots FinancialSnapshot[]
  supportQueuePolicies SupportQueuePolicy[]
  internalUserProfiles InternalUserProfile[]
  devTasks             DevTask[]
  clientPayments       ClientPayment[]
  expenses             Expense[]
  meetingAvailabilitySlots MeetingAvailabilitySlot[]
  customProjectMeetingBookings CustomProjectMeetingBooking[]
  tenantSubmodules         TenantSubmodule[]
  managementContract       TenantManagementContract?
  restContract             TenantRestContract?
  managementIdentityLinks ManagementIdentityLink[]
  managementSsoNonces      ManagementSsoNonce[]
  platformSyncEvents       PlatformSyncEvent[]
}

