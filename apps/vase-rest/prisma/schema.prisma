generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RestTenant {
  id             String                       @id @default(cuid())
  globalTenantId String                       @unique
  name           String
  slug           String                       @unique
  entitlement    RestEntitlementProjection?
  branches       Branch[]
  branchGroups   BranchGroup[]
  auditEvents    AuditEvent[]
  localEmployees LocalEmployee[]
  devices        Device[]
  edgeInstallations EdgeInstallation[]
  deviceEnrollments DeviceEnrollment[]
  configurationPolicies ConfigurationPolicy[]
  categories     MenuCategory[]
  products       MenuProduct[]
  ingredients    Ingredient[]
  modifierGroups ModifierGroup[]
  warehouses     Warehouse[]
  diningFloors   DiningFloor[]
  reservations   Reservation[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
}

model RestEntitlementProjection {
  id                String     @id @default(cuid())
  restTenantId      String     @unique
  globalTenantId    String     @unique
  plan              String
  status            String
  contractVersion   Int
  branchLimit       Int
  localEmployeeLimit Int
  deviceLimit       Int
  edgeLimit         Int
  effectiveAt       DateTime
  restTenant        RestTenant @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([globalTenantId, status])
}

model Branch {
  id             String              @id @default(cuid())
  restTenantId   String
  globalTenantId String
  code           String
  slug           String
  name           String
  timezone       String              @default("America/Argentina/Buenos_Aires")
  active         Boolean             @default(true)
  restTenant     RestTenant          @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  groupMembers   BranchGroupMember[]
  auditEvents    AuditEvent[]
  staffRoles     StaffBranchRole[]
  devices        Device[]
  staffSessions  StaffSession[]
  edgeInstallations EdgeInstallation[]
  deviceEnrollments DeviceEnrollment[]
  productAvailability ProductBranchAvailability[]
  warehouseLinks WarehouseBranch[]
  inventoryAllocations BranchInventoryAllocation[]
  diningFloors   DiningFloor[]
  diningTables   DiningTable[]
  reservations   Reservation[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([globalTenantId, code])
  @@unique([globalTenantId, slug])
  @@index([globalTenantId, active])
  @@index([restTenantId])
}

model LocalEmployee {
  id                String            @id @default(cuid())
  restTenantId      String
  globalTenantId    String
  employeeCode      String
  displayName       String
  pinHash           String
  active            Boolean           @default(true)
  failedPinAttempts Int               @default(0)
  lockedUntil       DateTime?
  pinChangedAt      DateTime           @default(now())
  restTenant        RestTenant        @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  branchRoles       StaffBranchRole[]
  sessions          StaffSession[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([globalTenantId, employeeCode])
  @@index([restTenantId, active])
}

model StaffBranchRole {
  id             String        @id @default(cuid())
  globalTenantId String
  localEmployeeId String
  branchId       String
  role           String
  localEmployee  LocalEmployee @relation(fields: [localEmployeeId], references: [id], onDelete: Cascade)
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([localEmployeeId, branchId])
  @@index([globalTenantId, branchId, role])
}

model Device {
  id              String         @id @default(cuid())
  restTenantId    String
  globalTenantId  String
  branchId        String
  name            String
  kind            String
  status          String         @default("ACTIVE")
  certificateFingerprint String?
  lastSeenAt      DateTime?
  restTenant      RestTenant     @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sessions        StaffSession[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([globalTenantId, branchId, status])
}

model EdgeInstallation {
  id                     String    @id @default(cuid())
  restTenantId           String
  globalTenantId         String
  branchId               String
  name                   String
  status                 String    @default("ACTIVE")
  certificateFingerprint String    @unique
  lastSeenAt             DateTime?
  restTenant             RestTenant @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  branch                 Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([globalTenantId, branchId, status])
}

model DeviceEnrollment {
  id             String     @id @default(cuid())
  restTenantId   String
  globalTenantId String
  branchId       String
  kind           String
  name           String
  codeHash       String     @unique
  deviceLimit    Int
  edgeLimit      Int
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdBy      String
  restTenant     RestTenant @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  branch         Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@index([globalTenantId, branchId, expiresAt])
}

model ConfigurationPolicy {
  id             String     @id @default(cuid())
  restTenantId   String
  globalTenantId String
  family         String
  scopeType      String
  scopeId        String
  value          Json
  revision       Int        @default(1)
  updatedBy      String
  restTenant     RestTenant @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([globalTenantId, family, scopeType, scopeId])
  @@index([globalTenantId, family])
}

model MenuCategory {
  id             String        @id @default(cuid())
  restTenantId   String
  globalTenantId String
  code           String
  name           String
  sortOrder      Int           @default(0)
  active         Boolean       @default(true)
  revision       Int           @default(1)
  restTenant     RestTenant    @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  products       MenuProduct[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([globalTenantId, code])
  @@index([globalTenantId, active, sortOrder])
}

model MenuProduct {
  id             String                 @id @default(cuid())
  restTenantId   String
  globalTenantId String
  categoryId     String
  sku            String
  name           String
  description    String?
  available      Boolean                @default(true)
  revision       Int                    @default(1)
  restTenant     RestTenant             @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  category       MenuCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recipeItems    RecipeItem[]
  prices         ProductPrice[]
  branchAvailability ProductBranchAvailability[]
  modifierGroups ProductModifierGroup[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([globalTenantId, sku])
  @@index([globalTenantId, categoryId, available])
}

model Ingredient {
  id             String       @id @default(cuid())
  restTenantId   String
  globalTenantId String
  sku            String
  name           String
  baseUnit       String
  active         Boolean      @default(true)
  restTenant     RestTenant   @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  recipeItems    RecipeItem[]
  inventoryBalances InventoryBalance[]
  inventoryMovements InventoryMovement[]
  inventoryAllocations BranchInventoryAllocation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([globalTenantId, sku])
}

model RecipeItem {
  id             String      @id @default(cuid())
  globalTenantId String
  productId      String
  ingredientId   String
  quantity       Decimal     @db.Decimal(18, 6)
  unit           String
  product        MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient     Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@index([globalTenantId, ingredientId])
}

model ProductPrice {
  id             String      @id @default(cuid())
  globalTenantId String
  productId      String
  scopeType      String
  scopeId        String
  amount         Decimal     @db.Decimal(18, 2)
  currency       String      @default("ARS")
  revision       Int         @default(1)
  product        MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([globalTenantId, productId, scopeType, scopeId])
}

model ProductBranchAvailability {
  id             String      @id @default(cuid())
  globalTenantId String
  productId      String
  branchId       String
  available      Boolean
  revision       Int         @default(1)
  product        MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([globalTenantId, branchId, available])
}

model ModifierGroup {
  id             String                 @id @default(cuid())
  restTenantId   String
  globalTenantId String
  code           String
  name           String
  minSelections  Int                    @default(0)
  maxSelections  Int                    @default(1)
  restTenant     RestTenant             @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  options        ModifierOption[]
  products       ProductModifierGroup[]

  @@unique([globalTenantId, code])
}

model ModifierOption {
  id              String        @id @default(cuid())
  globalTenantId  String
  modifierGroupId String
  code            String
  name            String
  priceDelta      Decimal       @default(0) @db.Decimal(18, 2)
  active          Boolean       @default(true)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([modifierGroupId, code])
}

model ProductModifierGroup {
  id              String        @id @default(cuid())
  globalTenantId  String
  productId       String
  modifierGroupId String
  sortOrder       Int           @default(0)
  product         MenuProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
}

model Warehouse {
  id             String                      @id @default(cuid())
  restTenantId   String
  globalTenantId String
  code           String
  name           String
  active         Boolean                     @default(true)
  restTenant     RestTenant                  @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  branches       WarehouseBranch[]
  balances       InventoryBalance[]
  movements      InventoryMovement[]
  allocations    BranchInventoryAllocation[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([globalTenantId, code])
  @@index([globalTenantId, active])
}

model WarehouseBranch {
  id             String    @id @default(cuid())
  globalTenantId String
  warehouseId    String
  branchId       String
  isDefault      Boolean   @default(false)
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, branchId])
  @@index([globalTenantId, branchId])
}

model InventoryBalance {
  id             String     @id @default(cuid())
  globalTenantId String
  warehouseId    String
  ingredientId   String
  onHand         Decimal    @default(0) @db.Decimal(18, 6)
  revision       Int        @default(1)
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  updatedAt      DateTime   @updatedAt

  @@unique([warehouseId, ingredientId])
  @@index([globalTenantId, ingredientId])
}

model InventoryMovement {
  id               String              @id @default(cuid())
  globalTenantId   String
  warehouseId      String
  ingredientId     String
  kind             String
  quantity         Decimal             @db.Decimal(18, 6)
  balanceAfter     Decimal             @db.Decimal(18, 6)
  commandId        String
  actorId          String
  referenceType    String?
  referenceId      String?
  reason           String?
  reversalOfId     String?             @unique
  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  ingredient       Ingredient          @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  reversalOf       InventoryMovement?  @relation("InventoryReversal", fields: [reversalOfId], references: [id])
  reversedBy       InventoryMovement?  @relation("InventoryReversal")
  occurredAt       DateTime            @default(now())

  @@unique([globalTenantId, commandId])
  @@index([globalTenantId, warehouseId, ingredientId, occurredAt])
}

model BranchInventoryAllocation {
  id             String     @id @default(cuid())
  globalTenantId String
  branchId       String
  warehouseId    String
  ingredientId   String
  available      Decimal    @db.Decimal(18, 6)
  safetyStock    Decimal    @default(0) @db.Decimal(18, 6)
  revision       Int        @default(1)
  branch         Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  consumptions   AllocationConsumption[]
  updatedAt      DateTime   @updatedAt

  @@unique([branchId, ingredientId])
  @@index([globalTenantId, warehouseId])
}

model AllocationConsumption {
  id             String                    @id @default(cuid())
  globalTenantId String
  allocationId   String
  commandId      String
  quantity       Decimal                   @db.Decimal(18, 6)
  remainingAfter Decimal                   @db.Decimal(18, 6)
  allocation     BranchInventoryAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  occurredAt     DateTime                  @default(now())

  @@unique([globalTenantId, commandId])
  @@index([allocationId, occurredAt])
}

model DiningFloor {
  id             String      @id @default(cuid())
  restTenantId   String
  globalTenantId String
  branchId       String
  code           String
  name           String
  sortOrder      Int         @default(0)
  active         Boolean     @default(true)
  revision       Int         @default(1)
  restTenant     RestTenant  @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zones          DiningZone[]
  tables         DiningTable[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([branchId, code])
  @@index([globalTenantId, branchId, active])
}

model DiningZone {
  id             String        @id @default(cuid())
  globalTenantId String
  floorId        String
  code           String
  name           String
  colorToken     String?
  floor          DiningFloor   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  tables         DiningTable[]

  @@unique([floorId, code])
}

model DiningTable {
  id             String             @id @default(cuid())
  globalTenantId String
  branchId       String
  floorId        String
  zoneId         String?
  code           String
  name           String
  capacity       Int
  x              Decimal            @db.Decimal(10, 2)
  y              Decimal            @db.Decimal(10, 2)
  width          Decimal            @db.Decimal(10, 2)
  height         Decimal            @db.Decimal(10, 2)
  status         String             @default("AVAILABLE")
  revision       Int                @default(1)
  mergeGroupId   String?
  mergedIntoId   String?
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floor          DiningFloor        @relation(fields: [floorId], references: [id], onDelete: Cascade)
  zone           DiningZone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  reservationLinks ReservationTable[]
  transitions    TableTransition[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([branchId, code])
  @@index([globalTenantId, branchId, status])
  @@index([mergeGroupId])
}

model TableTransition {
  id             String      @id @default(cuid())
  globalTenantId String
  branchId       String
  tableId        String
  fromStatus     String
  toStatus       String
  fromRevision   Int
  toRevision     Int
  actorId        String
  commandId      String
  table          DiningTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  occurredAt     DateTime    @default(now())

  @@unique([globalTenantId, commandId])
  @@index([tableId, occurredAt])
}

model Reservation {
  id             String             @id @default(cuid())
  restTenantId   String
  globalTenantId String
  branchId       String
  guestName      String
  guestPhone     String?
  partySize      Int
  startsAt       DateTime
  endsAt         DateTime
  status         String             @default("CONFIRMED")
  notes          String?
  revision       Int                @default(1)
  createdBy      String
  cancelledAt    DateTime?
  cancellationReason String?
  restTenant     RestTenant         @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables         ReservationTable[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([globalTenantId, branchId, startsAt, endsAt])
  @@index([branchId, status, startsAt])
}

model ReservationTable {
  id             String       @id @default(cuid())
  globalTenantId String
  reservationId  String
  tableId        String
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table          DiningTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([reservationId, tableId])
  @@index([globalTenantId, tableId])
}

model StaffSession {
  id              String        @id @default(cuid())
  globalTenantId  String
  localEmployeeId String
  branchId        String
  deviceId        String
  tokenHash       String        @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  localEmployee   LocalEmployee @relation(fields: [localEmployeeId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  device          Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([globalTenantId, branchId, expiresAt])
  @@index([localEmployeeId, revokedAt])
}

model BranchGroup {
  id             String              @id @default(cuid())
  restTenantId   String
  globalTenantId String
  code           String
  name           String
  restTenant     RestTenant          @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  members        BranchGroupMember[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([globalTenantId, code])
  @@index([restTenantId])
}

model BranchGroupMember {
  id             String      @id @default(cuid())
  globalTenantId String
  branchGroupId  String
  branchId       String
  branchGroup    BranchGroup @relation(fields: [branchGroupId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@unique([branchGroupId, branchId])
  @@index([globalTenantId, branchId])
}

model AuditEvent {
  id             String     @id @default(cuid())
  globalTenantId String
  restTenantId   String
  branchId       String?
  actorType      String
  actorId        String
  action         String
  entityType     String
  entityId       String
  payload        Json?
  occurredAt     DateTime   @default(now())
  restTenant     RestTenant @relation(fields: [restTenantId], references: [id], onDelete: Cascade)
  branch         Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([globalTenantId, occurredAt])
  @@index([globalTenantId, entityType, entityId])
  @@index([branchId, occurredAt])
}
