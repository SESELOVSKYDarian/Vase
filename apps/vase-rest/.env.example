# Public runtime
NEXT_PUBLIC_APP_URL=https://rest.vase.ar
PORT=3009

# Dedicated PostgreSQL service
DATABASE_URL=postgresql://vase_rest_user:CHANGE_ME_PASSWORD@postgres-rest:5432/vase_rest

# Shared Vase owner session and internal service access
AUTH_SECRET=CHANGE_ME_32_BYTE_AUTH_SECRET
AUTH_TRUST_HOST=true
VASE_APP_INTERNAL_URL=http://app-vase:3002
VASE_ADMIN_INTERNAL_URL=http://vase-admin:3003
VASE_WORKPLACE_INTERNAL_URL=http://vase-workplace:3008
SERVICE_TO_SERVICE_TOKEN=CHANGE_ME_SHARED_SERVICE_TOKEN
REST_CONTEXT_SIGNING_SECRET=CHANGE_ME_SHARED_CONTEXT_SIGNING_SECRET
REST_STAFF_SESSION_SECRET=CHANGE_ME_STAFF_SESSION_SECRET
REST_ENROLLMENT_SIGNING_SECRET=CHANGE_ME_ENROLLMENT_SIGNING_SECRET
REST_PUBLIC_URL=https://rest.vase.ar

# Server-only encryption and coordination
REST_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
REST_EDGE_SIGNING_KEY=CHANGE_ME_EDGE_SIGNING_KEY
REDIS_URL=redis://redis-platform:6379
