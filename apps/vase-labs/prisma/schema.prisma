generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum LabsPlan {
  STARTER
  GROWTH
  PRO
}

enum LabsChannel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum LabsChannelProvider {
  META_OFFICIAL
  OPENWA_UNOFFICIAL
  BAILEYS_UNOFFICIAL
}

enum ChannelConnectionStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
  QR_READY
}

enum MetaConnectionAttemptStatus {
  AUTHORIZING
  SELECTING_ASSET
  VERIFYING
  CONNECTED
  FAILED
}

enum TokenPack {
  BASIC
  MEDIUM
  PRO
}

enum LabsServiceStatus {
  ACTIVE
  TRIAL
  PAUSED
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  ESCALATED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ConversationIntentLabel {
  HOT_LEAD
  RESEARCHING
  LOW_INTENT
  HUMAN_REQUESTED
  UNCLASSIFIED
}

enum ConversationAnalysisJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ConversationOrderDraftState {
  COLLECTING
  QUOTED
  AWAITING_CONFIRMATION
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum AudioTranscriptionJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model Assistant {
  id             String   @id @default(cuid())
  globalTenantId String
  tenantSlug     String?  @unique
  name           String
  model          String
  systemPrompt   String?  @db.Text
  active         Boolean  @default(true)
  channels       Channel[]
  secrets        AssistantSecret[]
  knowledgeItems KnowledgeItem[]
  conversations  Conversation[]
  conversationInsightSettings ConversationInsightSettings?
  metaConnectionAttempts MetaConnectionAttempt[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([globalTenantId])
}

model AssistantSecret {
  id             String    @id @default(cuid())
  assistantId    String
  kind           String
  encryptedValue String    @db.Text
  rotatedAt      DateTime?
  assistant      Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([assistantId, kind])
  @@index([assistantId])
}

model Channel {
  id                String                  @id @default(cuid())
  assistantId       String
  type              LabsChannel
  provider          LabsChannelProvider?
  providerAccountId String?
  phoneNumberId     String?
  wabaId            String?
  accountLabel      String?
  externalId        String?
  externalHandle    String?
  webhookUrl        String?                 @db.Text
  config            Json?
  status            ChannelConnectionStatus @default(DISCONNECTED)
  connectedAt       DateTime?
  webhookVerifiedAt DateTime?
  lastSyncedAt      DateTime?
  lastError         String?                 @db.Text
  assistant         Assistant               @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  secrets           ChannelSecret[]
  webhookEvents     WebhookEvent[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([type, status])
  @@index([provider, status])
  @@unique([assistantId, type, providerAccountId])
}

model MetaConnectionAttempt {
  id                 String                      @id
  assistantId        String
  globalTenantId     String
  globalUserId       String
  tenantSlug         String
  channelType        LabsChannel
  status             MetaConnectionAttemptStatus @default(AUTHORIZING)
  stateHash          String                      @unique
  encryptedUserToken String?                     @db.Text
  candidates         Json?
  errorCode          String?
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  assistant          Assistant                   @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@index([globalTenantId, globalUserId, status])
  @@index([expiresAt])
}

model MetaOAuthState {
  id          String      @id @default(cuid())
  tenantSlug  String
  channelType LabsChannel
  stateHash   String      @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([tenantSlug, channelType])
  @@index([expiresAt])
}

model ChannelSecret {
  id             String    @id @default(cuid())
  channelId      String
  kind           String
  encryptedValue String    @db.Text
  expiresAt      DateTime?
  rotatedAt      DateTime?
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([channelId, kind])
  @@index([expiresAt])
}

model WebhookEvent {
  id                String             @id @default(cuid())
  channelId         String
  providerEventId   String?
  providerMessageId String?
  status            WebhookEventStatus @default(PROCESSING)
  metadata          Json?
  processedAt       DateTime?
  failedAt          DateTime?
  channel           Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([channelId, providerMessageId])
  @@index([channelId, status])
  @@index([providerEventId])
}

model LabsEntitlement {
  id                 String            @id @default(cuid())
  globalTenantId     String            @unique
  plan               LabsPlan
  status             LabsServiceStatus @default(ACTIVE)
  enabledChannels    Json
  channelLimits      Json
  tokenPack          TokenPack?
  tokensIncluded     Int
  tokensUsed         Int               @default(0)
  extraTokens        Int               @default(0)
  aiBudgetMicros     Int               @default(0)
  aiBudgetUsedMicros Int               @default(0)
  extraAiBudgetMicros Int              @default(0)
  currentPeriodStart DateTime?
  renewsAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([globalTenantId, status])
  @@index([renewsAt])
}

model CatalogProduct {
  id                  String   @id @default(cuid())
  globalTenantId      String
  externalProductId   String
  sku                 String?
  name                String
  description         String?  @db.Text
  price               Decimal? @db.Decimal(14, 2)
  stock               Int      @default(0)
  imageUrl            String?  @db.Text
  categories          Json
  active              Boolean  @default(true)
  sourceUpdatedAt     DateTime
  offeredByChatbot    Boolean  @default(false)
  aiAlias             String?
  aiDescription       String?  @db.Text
  aiInstructions      String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([globalTenantId, externalProductId])
  @@index([globalTenantId, active, offeredByChatbot])
  @@index([globalTenantId, stock])
}

model CatalogSyncEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  globalTenantId String
  productCount   Int
  occurredAt     DateTime
  processedAt    DateTime @default(now())

  @@index([globalTenantId, occurredAt])
}

model KnowledgeItem {
  id          String    @id @default(cuid())
  assistantId String
  title       String
  sourceType  String
  content     String    @db.Text
  status      String    @default("READY")
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Conversation {
  id                String             @id @default(cuid())
  assistantId       String
  channel           LabsChannel?
  status            ConversationStatus @default(OPEN)
  externalUserId    String?
  externalThreadKey String?
  customerName      String?
  customerContact   String?
  summary           String?            @db.Text
  intentLabel       String?
  intentScore       Int?
  metadata          Json?
  messageCount      Int                @default(0)
  escalatedToHuman  Boolean            @default(false)
  lastMessageAt     DateTime?
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  assistant         Assistant          @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  messages          Message[]
  handoffs          Handoff[]
  insight           ConversationInsight?
  analysisJob       ConversationAnalysisJob?
  orderDrafts       ConversationOrderDraft[]
  audioTranscriptionJobs AudioTranscriptionJob[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([assistantId, status, lastMessageAt])
  @@index([externalThreadKey])
  @@unique([assistantId, channel, externalThreadKey])
}

model AudioTranscriptionJob {
  id                String                      @id @default(cuid())
  conversationId    String
  messageId         String?
  globalTenantId    String
  assistantId       String
  channel           LabsChannel
  providerMediaId   String
  mimeType          String?
  status            AudioTranscriptionJobStatus @default(QUEUED)
  attempts          Int                         @default(0)
  transcript        String?                     @db.Text
  lastError         String?                     @db.Text
  leaseToken        String?
  leaseExpiresAt    DateTime?
  completedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  conversation      Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([assistantId, providerMediaId])
  @@index([status, leaseExpiresAt])
  @@index([conversationId, createdAt])
}

model ConversationOrderDraft {
  id                    String                      @id @default(cuid())
  conversationId        String
  assistantId           String
  globalTenantId        String
  state                 ConversationOrderDraftState @default(COLLECTING)
  revision              Int                         @default(1)
  channel               LabsChannel?
  items                 Json
  customer              Json
  fulfillment           Json
  quoteSnapshot         Json?
  quoteHash             String?
  quoteVersion          Int?
  confirmationCodeHash  String?
  confirmationSalt      String?
  expiresAt             DateTime?
  idempotencyKey        String                      @unique
  businessOrderId       String?
  businessOrderNumber   String?
  lastError             String?                     @db.Text
  confirmedAt           DateTime?
  conversation          Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([assistantId, state, updatedAt])
  @@index([globalTenantId, state, updatedAt])
  @@index([conversationId, state, updatedAt])
}

model BusinessOrderProjection {
  id                      String   @id @default(cuid())
  globalTenantId          String
  assistantId             String?
  conversationId          String?
  businessOrderId         String
  orderNumber             String
  status                  String
  channel                 String
  currency                String
  subtotalAmount          Decimal  @default(0) @db.Decimal(14, 2)
  shippingAmount          Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount             Decimal  @default(0) @db.Decimal(14, 2)
  customerName            String?
  customerEmail           String?
  customerEmailNormalized String?
  customerPhone           String?
  customerPhoneNormalized String?
  items                   Json
  rawSnapshot             Json
  version                 Int
  businessUpdatedAt       DateTime
  businessCreatedAt       DateTime?
  lastSyncedAt            DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  operationalStatus       String   @default("PROCESSING")
  operationalUpdatedAt    DateTime?
  readyAt                  DateTime?
  customerNotificationStatus String?
  customerNotifiedAt      DateTime?
  customerNotificationError String? @db.Text
  statusEvents            OrderStatusEvent[]

  @@unique([globalTenantId, businessOrderId])
  @@index([assistantId, businessUpdatedAt])
  @@index([globalTenantId, channel, status, businessUpdatedAt], name: "BOP_tenant_channel_status_updated_idx")
  @@index([conversationId])
  @@index([customerEmailNormalized])
  @@index([customerPhoneNormalized])
}

model OrderStatusEvent {
  id                 String   @id @default(cuid())
  orderProjectionId  String
  fromStatus         String?
  toStatus           String
  source             String   @default("TEAM")
  notificationStatus String?
  error              String?  @db.Text
  order              BusinessOrderProjection @relation(fields: [orderProjectionId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@index([orderProjectionId, createdAt])
}

model ConversationInsight {
  id                       String                  @id @default(cuid())
  conversationId           String                  @unique
  analysisVersion          Int
  summary                  String                  @db.Text
  currentNeed              String                  @db.Text
  productInterests         Json
  preferences              Json
  objections               Json
  budgetSignals            Json
  urgencySignals           Json
  recommendations          Json
  nextBestAction           String                  @db.Text
  scoreReasons             Json
  leadScore                Int
  intentLabel              ConversationIntentLabel
  identitySignals          Json
  analyzedThroughMessageId String
  analyzedAt               DateTime
  conversation             Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([intentLabel, leadScore])
  @@index([analyzedAt])
}

model ConversationInsightSettings {
  id                       String    @id @default(cuid())
  assistantId              String    @unique
  version                  Int       @default(1)
  hotLeadThreshold         Int       @default(75)
  purchaseIntentWeight     Int       @default(25)
  productDefinedWeight     Int       @default(15)
  budgetAcceptanceWeight   Int       @default(15)
  urgencyWeight            Int       @default(15)
  contactFulfillmentWeight Int       @default(10)
  interactionDepthWeight   Int       @default(10)
  negativeSignalsWeight    Int       @default(-10)
  assistant                Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model ConversationAnalysisJob {
  id                               String                        @id @default(cuid())
  conversationId                   String                        @unique
  requestedThroughMessageId        String
  requestedThroughMessageCreatedAt DateTime
  requestedAt                      DateTime                      @default(now())
  status                           ConversationAnalysisJobStatus @default(QUEUED)
  attempts                         Int                           @default(0)
  leaseToken                       String?
  leaseExpiresAt                   DateTime?
  lastError                        String?                       @db.Text
  conversation                     Conversation                  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt

  @@index([status, leaseExpiresAt])
  @@index([status, attempts, updatedAt])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  role              String
  direction         MessageDirection?
  content           String           @db.Text
  providerMessageId String?
  tokens            Int?
  costCents         Int?
  metadata          Json?
  analysisPendingAt DateTime?
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveries        MessageDelivery[]
  createdAt         DateTime         @default(now())

  @@index([providerMessageId])
  @@index([analysisPendingAt, id])
}

model MessageDelivery {
  id                String                @id @default(cuid())
  messageId         String
  channel           LabsChannel
  status            MessageDeliveryStatus @default(PENDING)
  providerMessageId String?
  error             String?               @db.Text
  metadata          Json?
  sentAt            DateTime?
  failedAt          DateTime?
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([messageId])
  @@index([channel, status])
}

model TokenUsage {
  id             String       @id @default(cuid())
  globalTenantId String
  assistantId    String?
  conversationId String?
  messageId      String?
  channel        LabsChannel
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  totalTokens    Int
  costCents      Int?
  costMicros     Int          @default(0)
  model          String?
  profile        String?
  source         String       @default("assistant")
  createdAt      DateTime     @default(now())

  @@index([globalTenantId, createdAt])
  @@index([conversationId])
  @@index([messageId])
  @@index([channel])
  @@index([assistantId])
}

model Handoff {
  id             String       @id @default(cuid())
  conversationId String
  reason         String
  target         String       @default("workplace")
  status         String       @default("PENDING")
  assignedTo     String?
  notes          String?      @db.Text
  priority       String       @default("normal")
  resolvedAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}
