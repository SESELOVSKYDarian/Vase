generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum LabsPlan {
  STARTER
  GROWTH
  PRO
}

enum LabsChannel {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum LabsChannelProvider {
  META_OFFICIAL
  OPENWA_UNOFFICIAL
  BAILEYS_UNOFFICIAL
}

enum ChannelConnectionStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
  QR_READY
}

enum MetaConnectionAttemptStatus {
  AUTHORIZING
  SELECTING_ASSET
  VERIFYING
  CONNECTED
  FAILED
}

enum TokenPack {
  BASIC
  MEDIUM
  PRO
}

enum LabsServiceStatus {
  ACTIVE
  TRIAL
  PAUSED
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  ESCALATED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Assistant {
  id             String   @id @default(cuid())
  globalTenantId String
  tenantSlug     String?  @unique
  name           String
  model          String
  systemPrompt   String?  @db.Text
  active         Boolean  @default(true)
  channels       Channel[]
  knowledgeItems KnowledgeItem[]
  conversations  Conversation[]
  metaConnectionAttempts MetaConnectionAttempt[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([globalTenantId])
}

model Channel {
  id                String                  @id @default(cuid())
  assistantId       String
  type              LabsChannel
  provider          LabsChannelProvider?
  providerAccountId String?
  phoneNumberId     String?
  wabaId            String?
  accountLabel      String?
  externalId        String?
  externalHandle    String?
  webhookUrl        String?                 @db.Text
  config            Json?
  status            ChannelConnectionStatus @default(DISCONNECTED)
  connectedAt       DateTime?
  lastSyncedAt      DateTime?
  lastError         String?                 @db.Text
  assistant         Assistant               @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  secrets           ChannelSecret[]
  webhookEvents     WebhookEvent[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([type, status])
  @@index([provider, status])
  @@unique([assistantId, type, providerAccountId])
}

model MetaConnectionAttempt {
  id                 String                      @id
  assistantId        String
  globalTenantId     String
  globalUserId       String
  tenantSlug         String
  channelType        LabsChannel
  status             MetaConnectionAttemptStatus @default(AUTHORIZING)
  stateHash          String                      @unique
  encryptedUserToken String?                     @db.Text
  candidates         Json?
  errorCode          String?
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  assistant          Assistant                   @relation(fields: [assistantId], references: [id], onDelete: Cascade)

  @@index([globalTenantId, globalUserId, status])
  @@index([expiresAt])
}

model MetaOAuthState {
  id          String      @id @default(cuid())
  tenantSlug  String
  channelType LabsChannel
  stateHash   String      @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([tenantSlug, channelType])
  @@index([expiresAt])
}

model ChannelSecret {
  id             String    @id @default(cuid())
  channelId      String
  kind           String
  encryptedValue String    @db.Text
  expiresAt      DateTime?
  rotatedAt      DateTime?
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([channelId, kind])
  @@index([expiresAt])
}

model WebhookEvent {
  id                String             @id @default(cuid())
  channelId         String
  providerEventId   String?
  providerMessageId String?
  status            WebhookEventStatus @default(PROCESSING)
  metadata          Json?
  processedAt       DateTime?
  failedAt          DateTime?
  channel           Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([channelId, providerMessageId])
  @@index([channelId, status])
  @@index([providerEventId])
}

model LabsEntitlement {
  id                 String            @id @default(cuid())
  globalTenantId     String            @unique
  plan               LabsPlan
  status             LabsServiceStatus @default(ACTIVE)
  enabledChannels    Json
  tokenPack          TokenPack?
  tokensIncluded     Int
  tokensUsed         Int               @default(0)
  extraTokens        Int               @default(0)
  currentPeriodStart DateTime?
  renewsAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([globalTenantId, status])
  @@index([renewsAt])
}

model KnowledgeItem {
  id          String    @id @default(cuid())
  assistantId String
  title       String
  sourceType  String
  content     String    @db.Text
  status      String    @default("READY")
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Conversation {
  id                String             @id @default(cuid())
  assistantId       String
  channel           LabsChannel?
  status            ConversationStatus @default(OPEN)
  externalUserId    String?
  externalThreadKey String?
  customerName      String?
  customerContact   String?
  summary           String?            @db.Text
  intentLabel       String?
  intentScore       Int?
  metadata          Json?
  messageCount      Int                @default(0)
  escalatedToHuman  Boolean            @default(false)
  lastMessageAt     DateTime?
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  assistant         Assistant          @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  messages          Message[]
  handoffs          Handoff[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([assistantId, status, lastMessageAt])
  @@index([externalThreadKey])
  @@unique([assistantId, channel, externalThreadKey])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  role              String
  direction         MessageDirection?
  content           String           @db.Text
  providerMessageId String?
  tokens            Int?
  costCents         Int?
  metadata          Json?
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deliveries        MessageDelivery[]
  createdAt         DateTime         @default(now())

  @@index([providerMessageId])
}

model MessageDelivery {
  id                String                @id @default(cuid())
  messageId         String
  channel           LabsChannel
  status            MessageDeliveryStatus @default(PENDING)
  providerMessageId String?
  error             String?               @db.Text
  metadata          Json?
  sentAt            DateTime?
  failedAt          DateTime?
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([messageId])
  @@index([channel, status])
}

model TokenUsage {
  id             String       @id @default(cuid())
  globalTenantId String
  assistantId    String?
  conversationId String?
  messageId      String?
  channel        LabsChannel
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  totalTokens    Int
  costCents      Int?
  source         String       @default("assistant")
  createdAt      DateTime     @default(now())

  @@index([globalTenantId, createdAt])
  @@index([conversationId])
  @@index([messageId])
  @@index([channel])
  @@index([assistantId])
}

model Handoff {
  id             String       @id @default(cuid())
  conversationId String
  reason         String
  target         String       @default("workplace")
  status         String       @default("PENDING")
  assignedTo     String?
  notes          String?      @db.Text
  priority       String       @default("normal")
  resolvedAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}
